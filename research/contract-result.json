{"success": true, "battleId": "sim-1792072205544", "winner": "Contract Test", "winnerSlot": "p1", "turns": 15, "replayHtml": "<!DOCTYPE html>\n<html>\n<head>\n  <meta charset=\"utf-8\">\n  <title>Pok\u00e9mon Showdown Battle Replay</title>\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <style>\n    * { box-sizing: border-box; }\n    html, body {\n      margin: 0;\n      padding: 0;\n      width: 100%;\n      height: 100%;\n      background: #090c10;\n      color: #e2e8f0;\n      font-family: -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, sans-serif;\n      overflow: hidden;\n    }\n    html body div.wrapper.replay-wrapper {\n      position: relative !important;\n      width: 100vw !important;\n      height: 100vh !important;\n      max-width: 100vw !important;\n      margin: 0 !important;\n      padding: 0 !important;\n      display: flex !important;\n      flex-direction: column !important;\n      align-items: center !important;\n      overflow: hidden !important;\n      background: #090c10 !important;\n    }\n    /* Scaled arena stage occupying full available viewport */\n    html body div.wrapper.replay-wrapper .arena-stage {\n      flex: 1 1 auto !important;\n      width: 100% !important;\n      height: calc(100vh - 54px) !important;\n      display: flex !important;\n      justify-content: center !important;\n      align-items: center !important;\n      position: relative !important;\n      overflow: hidden !important;\n      background: #090c10 !important;\n    }\n    html body div.wrapper.replay-wrapper .arena-stage .battle {\n      position: absolute !important;\n      top: 50% !important;\n      left: 50% !important;\n      transform: translate(-50%, -50%) scale(var(--battle-scale, 1.75)) !important;\n      transform-origin: center center !important;\n      box-shadow: 0 12px 48px rgba(0, 0, 0, 0.95) !important;\n      border-radius: 8px !important;\n      border: 1px solid #30363d !important;\n    }\n    /* Bottom Controls Footer */\n    html body div.wrapper.replay-wrapper .controls-footer {\n      flex: 0 0 54px !important;\n      height: 54px !important;\n      width: 100% !important;\n      background: #161b22 !important;\n      border-top: 1px solid #21262d !important;\n      display: flex !important;\n      justify-content: center !important;\n      align-items: center !important;\n      flex-wrap: nowrap !important;\n      overflow-x: auto !important;\n      overflow-y: hidden !important;\n      gap: 5px !important;\n      z-index: 50 !important;\n      padding: 0 8px !important;\n    }\n    html body div.wrapper.replay-wrapper .controls-footer .replay-controls,\n    html body div.wrapper.replay-wrapper .controls-footer .replay-controls-2 {\n      position: static !important;\n      top: auto !important;\n      left: auto !important;\n      right: auto !important;\n      bottom: auto !important;\n      display: flex !important;\n      align-items: center !important;\n      gap: 3px !important;\n      margin: 0 !important;\n      padding: 0 !important;\n    }\n    html body div.wrapper.replay-wrapper .controls-footer button,\n    html body div.wrapper.replay-wrapper .controls-footer .btn-log-toggle {\n      background: #21262d !important;\n      color: #c9d1d9 !important;\n      border: 1px solid #30363d !important;\n      border-radius: 4px !important;\n      padding: 2px 6px !important;\n      font-size: 8px !important;\n      line-height: 1 !important;\n      width: auto !important;\n      min-width: 0 !important;\n      white-space: nowrap !important;\n      height: 26px !important;\n      min-height: 26px !important;\n      max-height: 26px !important;\n      font-weight: 600 !important;\n      cursor: pointer !important;\n      transition: all 0.15s ease !important;\n    }\n    html body div.wrapper.replay-wrapper .controls-footer button:hover,\n    html body div.wrapper.replay-wrapper .controls-footer .btn-log-toggle:hover {\n      background: #30363d !important;\n      color: #ffffff !important;\n      border-color: #6e7681 !important;\n    }\n    html body div.wrapper.replay-wrapper .controls-footer .replay-controls-2 button.sel {\n      background: #30363d !important;\n      color: #ffffff !important;\n      border-color: #8b949e !important;\n    }\n    html body div.wrapper.replay-wrapper .controls-footer .btn-log-toggle.active {\n      background: #30363d !important;\n      color: #ffffff !important;\n      border-color: #8b949e !important;\n    }\n    /* Battle Log Drawer (Modal popup above footer) */\n    html body div.wrapper.replay-wrapper .battle-log {\n      position: fixed !important;\n      bottom: 54px !important;\n      left: 50% !important;\n      transform: translateX(-50%) !important;\n      width: 90% !important;\n      max-width: 820px !important;\n      height: 250px !important;\n      background: rgba(22, 27, 34, 0.98) !important;\n      backdrop-filter: blur(10px) !important;\n      border: 1px solid #30363d !important;\n      border-radius: 8px !important;\n      box-shadow: 0 16px 40px rgba(0, 0, 0, 0.95) !important;\n      padding: 12px 16px !important;\n      z-index: 100 !important;\n      display: none !important;\n      overflow-y: auto !important;\n      font-size: 12px !important;\n      line-height: 1.5 !important;\n      color: #e2e8f0 !important;\n    }\n    html body div.wrapper.replay-wrapper .battle-log.visible {\n      display: block !important;\n    }\n  </style>\n  <script src=\"https://play.pokemonshowdown.com/js/lib/jquery-1.11.0.min.js\"></script>\n</head>\n<body class=\"dark\">\n  <div class=\"wrapper replay-wrapper\">\n    <input type=\"hidden\" name=\"replayid\" value=\"sim-1792072205544\" />\n    \n    <!-- Full-viewport arena stage -->\n    <div class=\"arena-stage\">\n      <div class=\"battle\"></div>\n    </div>\n\n    <!-- Fixed Controls Footer -->\n    <div class=\"controls-footer\">\n      <div class=\"replay-controls\"></div>\n      <div class=\"replay-controls-2\">\n  