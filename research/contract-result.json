2a: Ferrothorn\n|-damage|p2a: Ferrothorn|0 fnt\n|-damage|p1a: Corviknight|313/400|[from] ability: Iron Barbs|[of] p2a: Ferrothorn\n|faint|p2a: Ferrothorn\n|\n|win|Contract Test\n</script>\n  </div>\n  <script src=\"https://play.pokemonshowdown.com/js/replay-embed.js\"></script>\n  <script>\n    // Dynamic arena auto-scaling to fill 100% of left screen\n    function fitArena() {\n      var stage = document.querySelector('.arena-stage');\n      var battle = document.querySelector('.battle');\n      if (!stage) return;\n      var w = stage.clientWidth;\n      var h = stage.clientHeight;\n      if (w <= 0 || h <= 0) return;\n      \n      // Calculate scale to fill available arena stage\n      var scaleW = (w - 16) / 640;\n      var scaleH = (h - 16) / 360;\n      var scale = Math.min(scaleW, scaleH);\n      scale = Math.max(0.6, scale * 0.97);\n      \n      document.documentElement.style.setProperty('--battle-scale', scale);\n      if (battle) {\n        battle.style.setProperty('transform', 'translate(-50%, -50%) scale(' + scale + ')', 'important');\n        battle.style.setProperty('transform-origin', 'center center', 'important');\n        battle.style.setProperty('top', '50%', 'important');\n        battle.style.setProperty('left', '50%', 'important');\n      }\n    }\n\n    window.addEventListener('resize', fitArena);\n    window.addEventListener('orientationchange', fitArena);\n    document.addEventListener('DOMContentLoaded', fitArena);\n    window.addEventListener('load', fitArena);\n\n    // Keep fitArena hooked into Showdown instance\n    var hookShowdown = setInterval(function() {\n      fitArena();\n      if (window.Replays && window.Replays.battle) {\n        window.Replays.battle.onResize = fitArena;\n      }\n    }, 200);\n    setTimeout(function() { clearInterval(hookShowdown); }, 5000);\n\n    // Setup log toggle button\n    document.addEventListener('DOMContentLoaded', function() {\n      var btn = document.getElementById('btnToggleLog');\n      var log = document.getElementById('battleLogContainer');\n      if (btn && log) {\n        btn.addEventListener('click', function() {\n          var isVis = log.classList.contains('visible');\n          if (isVis) {\n            log.classList.remove('visible');\n            btn.classList.remove('active');\n            btn.textContent = 'Show Battle Log';\n          } else {\n            log.classList.add('visible');\n            btn.classList.add('active');\n            btn.textContent = 'Hide Battle Log';\n            log.scrollTop = log.scrollHeight;\n          }\n        });\n      }\n    });\n\n    window.addEventListener('load', function() {\n      fitArena();\n      setTimeout(function() {\n        fitArena();\n        if (window.Replays && window.Replays.battle) {\n          if (window.Replays.changeSetting) window.Replays.changeSetting('speed', 'fast');\n          window.Replays.play();\n        }\n      }, 400);\n    });\n  </script>\n</body>\n</html>"}